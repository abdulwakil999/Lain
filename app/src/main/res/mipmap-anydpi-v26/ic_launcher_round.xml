<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon. Without one, Android 8+ launchers draw the legacy PNG shrunk
    inside a white or grey plate, which is why the icon sat in a pale square
    instead of filling the shape the launcher uses for everything else.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_lain_glyph" />
</adaptive-icon>
