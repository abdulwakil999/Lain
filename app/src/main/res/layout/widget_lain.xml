<?xml version="1.0" encoding="utf-8"?>
<!--
    Small square widget: Lain's face, one tap to talk.

    RemoteViews can only inflate a fixed set of view types, so this is plain
    LinearLayout/ImageView/TextView rather than anything Compose-shaped.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_lain_glyph"
        android:contentDescription="Lain"
        android:adjustViewBounds="true" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ASK LAIN"
        android:textColor="#14161C"
        android:textStyle="bold"
        android:maxLines="1"
        android:textSize="12sp" />

</LinearLayout>
