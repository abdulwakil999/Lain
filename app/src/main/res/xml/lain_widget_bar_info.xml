<?xml version="1.0" encoding="utf-8"?>
<!-- The wide bar. Resizes horizontally across the full width of a home screen;
     vertical resizing is off because the row has a fixed height by design. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="57dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="57dp"
    android:maxResizeWidth="700dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_lain_bar"
    android:previewLayout="@layout/widget_lain_bar"
    android:description="@string/widget_bar_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen|keyguard"
    android:configure="com.lain.assistant.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
