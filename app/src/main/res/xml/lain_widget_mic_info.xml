<?xml version="1.0" encoding="utf-8"?>
<!-- The single-cell button. Deliberately not resizable: it is one glyph, and
     stretching it just produces a smeared icon. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="57dp"
    android:minHeight="57dp"
    android:minResizeWidth="57dp"
    android:minResizeHeight="57dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_lain_mic"
    android:previewLayout="@layout/widget_lain_mic"
    android:description="@string/widget_mic_description"
    android:resizeMode="none"
    android:widgetCategory="home_screen|keyguard"
    android:configure="com.lain.assistant.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
