<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice + vision perception -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Telephony actions -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        The calendar already on the phone. Read and write are separate grants and are
        asked for separately: "what's on today" is a much smaller thing to allow than
        "put things in my diary", and demanding both to answer the first is how an app
        gets declined.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Reminders + notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Do Not Disturb. Not granted by install: the user allows it on a Settings
         screen, and until they do, Lain says so rather than pretending. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
         Exact alarms. Lain is an alarm clock now — she rings, snoozes and repeats —
         which is precisely the use these two exist for. SCHEDULE_EXACT_ALARM is the
         user-grantable form; USE_EXACT_ALARM is install-granted on Android 13+ for
         alarm and calendar apps, so a user who sets an alarm is not sent hunting
         through Settings before it can ring on the minute. Lint flags the pair as
         system-only, which is wrong for an alarm app; both are documented as
         available to exactly this case.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
        Setting alarms in the phone's own clock app. A normal permission, granted at
        install: no dialog, no special access. It is what lets an alarm land where the
        user actually looks for alarms rather than in a second system inside Lain.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lets a scheduled task raise its own screen when the phone is locked or the
         screen is off. A plain activity start from a receiver is refused on Android
         10+, which is why alarms fired on some phones and not others. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- "Where am I". Coarse only: Lain reports the area, never tracks, and never
         sends a position anywhere. Requested at the point of use, not at install. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The alarm vibrates. Without this the pattern is silently ignored, so an
         alarm on a muted phone does nothing at all. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Screen brightness. Not a runtime permission: Android grants this only from
        its own "Modify system settings" screen, which is why ScreenBrightness opens
        that screen and says so rather than showing a dialog that cannot exist.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Used only by close_app's background-process path, which is the one thing
         Android still allows a normal app to stop. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Floating bubble so Lain can be commanded from outside the app -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Keeps a task running with the screen locked -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Screen sharing / on-screen automation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Package visibility for launching/inspecting other apps (Chrome, WhatsApp, dialer, chess apps, etc.) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!--
            Named explicitly as well as covered by QUERY_ALL_PACKAGES, because the
            broad permission is the one a store is most likely to strip. WhatsApp
            Business is a separate package from WhatsApp and speaks the same deep
            links: leaving it out is what made Lain report WhatsApp as not installed
            on a phone that had it.
        -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.spotify.music" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:name=".LainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Lain"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lain"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The share sheet. Without these Lain simply is not in the list when you
                share a photo, a PDF or a link from another app — the only way to get a
                file to her was her own attach button.

                Wildcard MIME on purpose: she now reads images, PDFs, Office documents,
                video frames and plain text, and says plainly what she can't make of
                anything else. Being in the sheet and explaining the limit beats being
                absent from it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!--
                Long-pressing the Quick Settings tile. Without this filter Android has
                nowhere to send the gesture and falls back to App Info, which is a
                system settings page and not what someone holding Lain's tile wants.
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The target for a long-press on a widget. No UI: it answers the launcher and
            opens Lain. configuration_optional (Android 12+) keeps it out of the way
            when a widget is first placed, so it only runs when the gesture asks for it.
        -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            The assistant gesture. Declaring ACTION_ASSIST is what puts Lain in
            Settings → Default apps → Digital assistant, which is the only way she can
            become the app the power-button hold opens: an app cannot select itself.

            exported because the system starts it from outside the app. It is a
            forwarder with no UI and no state, and it discards the screenshot and
            structured app data ACTION_ASSIST offers rather than accepting them.
        -->
        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Compact surface for the widget/tile/bubble/wake word: a message bar and
             recent messages over a translucent scrim, instead of the whole app. -->
        <activity
            android:name=".MiniActivity"
            android:exported="false"
            android:theme="@style/Theme.Lain.Mini"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:turnScreenOn="true"
            android:showWhenLocked="true" />

        <!-- The ringing surface for alarms and scheduled calls. Shows over the
             lock screen because an alarm that needs unlocking first is not an alarm.
             excludeFromRecents so a dismissed alarm doesn't linger in the switcher. -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:exported="false"
            android:theme="@style/Theme.Lain"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true" />

        <!-- Accessibility Service: powers screen reading + simulated taps, the
             same mechanism assistive tools like TalkBack rely on. This is what
             lets Lain act as a full screen-reader/control layer for blind users
             and drive apps that have no other automation hook. -->
        <service
            android:name=".automation.LainAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
             Reads the notification shade, and only once the user has granted access
             on the dedicated Settings screen. Android gates this deliberately because
             it exposes message previews and one-time codes; nothing in the app tries
             to route around that.
        -->
        <service
            android:name=".automation.LainNotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".automation.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
             Hands-free listening. foregroundServiceType="microphone" plus
             FOREGROUND_SERVICE_MICROPHONE is what Android 14 requires before an app
             may hold the microphone outside the foreground, and the ongoing
             notification the service posts is the other half of that contract — it
             is also the honest signal, because while this is on the microphone
             genuinely is open. There is no path here that records without
             RECORD_AUDIO: the service checks it on start and on every loop, and
             stops itself when it is missing.
        -->
        <service
            android:name=".automation.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Runs only while a task is in flight, holding a wake lock so the tool
             loop keeps executing with the screen off. -->
        <service
            android:name=".agent.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The "always on" switch in Settings. Holds no wake lock: it exists so the
             process is not reaped, which is what makes alarms land on the minute and
             keeps the wake word from going deaf. -->
        <service
            android:name=".agent.AlwaysOnService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent assistant the user explicitly switches on, so scheduled tasks and the wake word keep working when the app is not in the foreground." />
        </service>

        <service
            android:name=".automation.OverlayBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent assistant bubble the user explicitly enables, so Lain can be commanded from any screen." />
        </service>

        <!-- Quick Settings tile: toggles the "Hello Lain" wake-word listener from the shade. -->
        <service
            android:name=".automation.VoiceInputTileService"
            android:exported="true"
            android:icon="@drawable/ic_lain_glyph"
            android:label="Lain"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Grants the camera app write access to one folder in Lain's cache, and
             nothing else. Required from Android 7: a bare file:// URI handed to
             another app throws FileUriExposedException. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".automation.ReminderReceiver"
            android:exported="false" />

        <!-- Scheduled tasks: alarms, reminders, recurring calls and texts. -->
        <receiver
            android:name=".automation.ScheduledTaskReceiver"
            android:exported="false" />

        <!-- AlarmManager is wiped by a reboot, so every task is re-armed here.
             Without this an alarm silently stops existing after a restart. -->
        <receiver
            android:name=".automation.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
             Home screen widgets. Three shapes for three habits: a square for the
             home screen, a single cell for people who keep a tidy dock, and a wide
             bar whose separate buttons make "read the screen" one tap.

             exported="true" on all of them, and it is load-bearing: a widget
             provider is a receiver the launcher broadcasts to from its own process.
             With export off the system cannot deliver APPWIDGET_UPDATE, the click
             targets are never bound, and the widget simply does nothing when tapped.
        -->
        <receiver
            android:name=".automation.LainWidgetProvider"
            android:label="Lain"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lain_widget_info" />
        </receiver>

        <receiver
            android:name=".automation.LainMicWidgetProvider"
            android:label="Lain button"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lain_widget_mic_info" />
        </receiver>

        <receiver
            android:name=".automation.LainBarWidgetProvider"
            android:label="Lain bar"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lain_widget_bar_info" />
        </receiver>

    </application>

</manifest>
